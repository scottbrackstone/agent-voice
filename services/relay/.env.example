PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Shared bearer token for the Android app. When set, every route except /health
# and the webhook needs `Authorization: Bearer <token>`. Set it whenever HOST is
# not 127.0.0.1, and put the same value in the Android app's local.properties
# as agentvoice.relayToken. Generate with: openssl rand -hex 32
AGENTVOICE_RELAY_TOKEN=

# OpenClaw is connector #1, not the product identity.
# Uses the OpenClaw Gateway OpenAI-compatible HTTP endpoint:
# POST /v1/chat/completions
# Enable gateway.http.endpoints.chatCompletions.enabled in OpenClaw before live use.
OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=
OPENCLAW_TOKEN=
OPENCLAW_MODEL=openclaw
OPENCLAW_USER=agentvoice-mobile
OPENCLAW_SESSION_KEY=
OPENCLAW_AGENT_ID=
OPENCLAW_TIMEOUT_MS=10000

# Hermes connector. Assumes an OpenAI-compatible chat endpoint:
# POST /v1/chat/completions
HERMES_ENABLED=false
HERMES_BASE_URL=
HERMES_TOKEN=
HERMES_MODEL=hermes
HERMES_USER=agentvoice-mobile
HERMES_TIMEOUT_MS=120000

# Scheduled/background delivery inbox.
# Hermes cron jobs POST here with X-Relay-Token to queue messages for Android polling.
AGENTVOICE_INBOX_DB_PATH=data/agentvoice-inbox.sqlite
AGENTVOICE_WEBHOOK_TOKEN=

# Firebase Cloud Messaging for closed-app Android notifications.
# Point GOOGLE_APPLICATION_CREDENTIALS at a Firebase service-account JSON file.
AGENTVOICE_FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional turn-based Voxtral transcription for Android Driving Mode.
# Keep this key on the relay. Do not put it in Android.
MISTRAL_API_KEY=
VOXTRAL_TRANSCRIBE_MODEL=voxtral-mini-latest
VOXTRAL_TRANSCRIBE_LANGUAGE=en
VOXTRAL_TRANSCRIBE_TIMEOUT_MS=90000
